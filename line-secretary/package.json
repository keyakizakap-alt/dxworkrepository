{
  "name": "line-secretary",
  "version": "0.1.0",
  "private": true,
  "description": "LINEグループに招待して、普通に話しかけるだけで使えるお知らせ・やること係（ことづて）",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "mock": "tsx src/node-server.ts",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply line-secretary --local",
    "db:migrate:remote": "wrangler d1 migrations apply line-secretary --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
