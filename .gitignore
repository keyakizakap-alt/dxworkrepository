# ${PLUGIN_DATA} directories: runtime state, never packaged
plugins/*/.data/

# Client-native MCP configs generated by ap_export.py are derived artifacts.
# Commit them deliberately (remove the matching line) if a team shares them;
# they contain absolute paths from whichever machine ran the export.
.vscode/mcp.json
.cursor/mcp.json
.codex/

__pycache__/
*.py[cod]
